{
  "name": "specmint",
  "version": "0.5.2",
  "description": "面向 agent 的 Playwright 页面测试 CLI 工具：自然语言生成用例、可重跑、历史可追溯",
  "type": "module",
  "bin": {
    "specmint": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"if(process.platform!=='win32')require('node:fs').chmodSync('dist/cli.js',0o755)\"",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "init": "tsx src/cli.ts init",
    "test": "tsx src/cli.ts run",
    "test:headed": "tsx src/cli.ts run --headed",
    "test:ui": "tsx src/cli.ts run --ui",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "commander": "^15.0.0",
    "typebox": "^1.0.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.58.0",
    "playwright": ">=1.58.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": false
    },
    "playwright": {
      "optional": false
    }
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "@types/node": "^22.0.0",
    "playwright": "1.58.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0"
  },
  "keywords": [
    "playwright",
    "testing",
    "agent",
    "e2e",
    "ai",
    "cli"
  ],
  "author": "specmint contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/catrossim/specmint.git"
  },
  "homepage": "https://github.com/catrossim/specmint#readme",
  "bugs": {
    "url": "https://github.com/catrossim/specmint/issues"
  }
}
